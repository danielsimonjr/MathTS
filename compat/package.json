{
  "name": "@danielsimonjr/mathts-compat",
  "version": "0.5.0",
  "description": "mathjs compatibility layer for MathTS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm && tsc -p tsconfig.dts.json && node ../tools/ensure-js-sourcemaps.mjs",
    "dev": "tsdown src/index.ts --format esm --watch --on-success \"tsc -p tsconfig.dts.json && node ../tools/ensure-js-sourcemaps.mjs\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test --isolate --timeout 30000",
    "test:coverage": "bun test --isolate --timeout 30000 --coverage",
    "build:prod": "tsdown src/index.ts --format esm --minify && tsc -p tsconfig.dts.json && node ../tools/ensure-js-sourcemaps.mjs"
  },
  "tsdown": {
    "fixedExtension": false,
    "dts": false,
    "outputOptions": {
      "comments": {
        "legal": true,
        "annotation": true,
        "jsdoc": false
      }
    },
    "sourcemap": true
  },
  "dependencies": {
    "@danielsimonjr/mathts-core": "^0.27.0",
    "@danielsimonjr/mathts-functions": "^0.85.0",
    "@danielsimonjr/mathts-matrix": "^0.10.1",
    "@danielsimonjr/mathts-parallel": "^0.10.1",
    "typed-function": "npm:@danielsimonjr/typed-function@5.0.0-alpha.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "mathjs": "15.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "math",
    "mathjs",
    "compat",
    "compatibility",
    "migration"
  ],
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "compat"
  },
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/danielsimonjr/MathTS#readme",
  "bugs": {
    "url": "https://github.com/danielsimonjr/MathTS/issues"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=22.12"
  }
}
