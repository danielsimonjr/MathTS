{
  "name": "@danielsimonjr/mathts-compat",
  "version": "0.4.30",
  "description": "mathjs compatibility layer for MathTS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm && tsc -p tsconfig.dts.json",
    "dev": "tsdown src/index.ts --format esm --watch --on-success \"tsc -p tsconfig.dts.json\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test --isolate --timeout 30000",
    "test:coverage": "bun test --isolate --timeout 30000 --coverage",
    "build:prod": "tsdown src/index.ts --format esm --minify && tsc -p tsconfig.dts.json"
  },
  "tsdown": {
    "fixedExtension": false,
    "dts": false,
    "outputOptions": {
      "comments": {
        "legal": true,
        "annotation": true,
        "jsdoc": false
      }
    }
  },
  "dependencies": {
    "@danielsimonjr/mathts-core": "^0.18.0",
    "@danielsimonjr/mathts-functions": "^0.68.2",
    "@danielsimonjr/mathts-matrix": "^0.7.8",
    "@danielsimonjr/mathts-parallel": "^0.6.10"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "math",
    "mathjs",
    "compat",
    "compatibility",
    "migration"
  ],
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "compat"
  },
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  }
}
