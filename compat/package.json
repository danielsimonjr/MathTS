{
  "name": "@danielsimonjr/mathts-compat",
  "version": "0.4.25",
  "description": "mathjs compatibility layer for MathTS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.dts.json",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess \"tsc -p tsconfig.dts.json\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test --isolate --timeout 30000",
    "test:coverage": "bun test --isolate --timeout 30000 --coverage",
    "build:prod": "tsup src/index.ts --format esm --clean --minify --treeshake && tsc -p tsconfig.dts.json"
  },
  "dependencies": {
    "@danielsimonjr/mathts-core": "^0.15.5",
    "@danielsimonjr/mathts-functions": "^0.65.0",
    "@danielsimonjr/mathts-matrix": "^0.7.5",
    "@danielsimonjr/mathts-parallel": "^0.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "math",
    "mathjs",
    "compat",
    "compatibility",
    "migration"
  ],
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "compat"
  },
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  }
}
