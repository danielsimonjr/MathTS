{
  "name": "@danielsimonjr/mathts-trigonometry",
  "version": "0.1.86",
  "description": "Standalone trigonometric functions for MathTS, re-exported as a focused package",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm && tsc -p tsconfig.dts.json && node ../tools/ensure-js-sourcemaps.mjs",
    "dev": "tsdown src/index.ts --format esm --watch --on-success \"tsc -p tsconfig.dts.json && node ../tools/ensure-js-sourcemaps.mjs\"",
    "test": "bun test",
    "test:watch": "vitest",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsdown src/index.ts --format esm --minify && tsc -p tsconfig.dts.json && node ../tools/ensure-js-sourcemaps.mjs"
  },
  "tsdown": {
    "fixedExtension": false,
    "dts": false,
    "outputOptions": {
      "comments": {
        "legal": true,
        "annotation": true,
        "jsdoc": false
      }
    },
    "sourcemap": true
  },
  "dependencies": {
    "@danielsimonjr/mathts-functions": "^0.84.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "trigonometry"
  },
  "keywords": [
    "math",
    "typescript",
    "trigonometry",
    "sin",
    "cos",
    "tan"
  ],
  "homepage": "https://github.com/danielsimonjr/MathTS#readme",
  "bugs": {
    "url": "https://github.com/danielsimonjr/MathTS/issues"
  },
  "sideEffects": false
}
