{
  "name": "@danielsimonjr/mathts-workerpool",
  "version": "0.2.6",
  "description": "Worker pool management for MathTS parallel computations",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/worker.ts --format esm && tsc -p tsconfig.dts.json && node scripts/postbuild.mjs",
    "dev": "tsdown src/index.ts src/worker.ts --format esm --watch --on-success \"tsc -p tsconfig.dts.json && node scripts/postbuild.mjs\"",
    "test": "bun test --isolate --timeout 30000",
    "test:watch": "vitest",
    "test:coverage": "bun test --isolate --timeout 30000 --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsdown src/index.ts src/worker.ts --format esm --minify && tsc -p tsconfig.dts.json && node scripts/postbuild.mjs"
  },
  "tsdown": {
    "fixedExtension": false,
    "dts": false,
    "outputOptions": {
      "comments": {
        "legal": true,
        "annotation": true,
        "jsdoc": false
      }
    }
  },
  "dependencies": {
    "workerpool": "npm:@danielsimonjr/workerpool@10.2.2"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "packages/workerpool"
  },
  "keywords": [
    "math",
    "typescript",
    "workerpool",
    "parallel",
    "worker",
    "webworker",
    "threading"
  ]
}
