{
  "name": "@danielsimonjr/mathts-workerpool",
  "version": "0.2.0",
  "description": "Worker pool management for MathTS parallel computations",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/worker.ts --format esm --dts --clean && node scripts/postbuild.mjs",
    "dev": "tsup src/index.ts src/worker.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsup src/index.ts src/worker.ts --format esm --dts --clean --minify --treeshake && node scripts/postbuild.mjs"
  },
  "dependencies": {
    "workerpool": "github:danielsimonjr/workerpool"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/mathts",
    "directory": "packages/workerpool"
  },
  "keywords": [
    "math",
    "typescript",
    "workerpool",
    "parallel",
    "worker",
    "webworker",
    "threading"
  ]
}
