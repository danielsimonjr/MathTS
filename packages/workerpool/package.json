{
  "name": "@danielsimonjr/mathts-workerpool",
  "version": "0.4.1",
  "description": "Worker pool management for MathTS parallel computations",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "browser": "./dist/worker.browser.js",
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/worker.ts --format esm && tsdown --config tsdown.browser.config.ts && tsc -p tsconfig.dts.json && node scripts/postbuild.mjs && node ../../tools/ensure-js-sourcemaps.mjs",
    "dev": "tsdown src/index.ts src/worker.ts --format esm --watch --on-success \"tsdown --config tsdown.browser.config.ts && tsc -p tsconfig.dts.json && node scripts/postbuild.mjs && node ../../tools/ensure-js-sourcemaps.mjs\"",
    "test": "bun test --isolate --timeout 30000",
    "test:watch": "vitest",
    "test:coverage": "bun test --isolate --timeout 30000 --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsdown src/index.ts src/worker.ts --format esm --minify && tsdown --config tsdown.browser.config.ts --minify && tsc -p tsconfig.dts.json && node scripts/postbuild.mjs && node ../../tools/ensure-js-sourcemaps.mjs"
  },
  "tsdown": {
    "fixedExtension": false,
    "dts": false,
    "outputOptions": {
      "comments": {
        "legal": true,
        "annotation": true,
        "jsdoc": false
      }
    },
    "sourcemap": true
  },
  "dependencies": {
    "workerpool": "npm:@danielsimonjr/workerpool@10.2.2"
  },
  "devDependencies": {
    "@danielsimonjr/mathts-core": "^0.27.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "packages/workerpool"
  },
  "keywords": [
    "math",
    "typescript",
    "workerpool",
    "parallel",
    "worker",
    "webworker",
    "threading"
  ],
  "homepage": "https://github.com/danielsimonjr/MathTS#readme",
  "bugs": {
    "url": "https://github.com/danielsimonjr/MathTS/issues"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=22.12"
  }
}
