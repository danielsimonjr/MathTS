{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // TypeScript 7 does not auto-include node_modules/@types; a package that
    // typechecks without this is relying on a dependency shipping its own node
    // reference, which a bump can remove.
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/config.ts",
    "src/types/complex.ts",
    "src/types/fraction.ts",
    "src/types/bignumber.ts",
    "src/types/interfaces.ts",
    "src/types/index.ts",
    "src/typed/**/*.ts",
    "src/factory/**/*.ts",
    "src/typed-function.d.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
