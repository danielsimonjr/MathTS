{
  "name": "@danielsimonjr/mathts-workbook",
  "version": "1.0.0",
  "description": "MathTS Scientific Workbook Runtime - YAML-based reactive notebooks for scientific computing",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "mtsw": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mathts",
    "scientific-computing",
    "notebook",
    "workbook",
    "yaml",
    "reactive",
    "tensor",
    "physics",
    "mathematics",
    "visualization",
    "threejs",
    "typescript"
  ],
  "author": "Daniel Simon Jr. <danielsimonjr@github>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/mathts.git",
    "directory": "packages/workbook"
  },
  "bugs": {
    "url": "https://github.com/danielsimonjr/mathts/issues"
  },
  "homepage": "https://github.com/danielsimonjr/mathts#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "yaml": "^2.3.4",
    "commander": "^11.1.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^3.2.6",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2"
  },
  "peerDependencies": {
    "@danielsimonjr/mathts-core": ">=1.0.0",
    "@mathts/tensor": ">=1.0.0",
    "@mathts/symbolic": ">=1.0.0",
    "@mathts/viz": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@danielsimonjr/mathts-core": {
      "optional": true
    },
    "@mathts/tensor": {
      "optional": true
    },
    "@mathts/symbolic": {
      "optional": true
    },
    "@mathts/viz": {
      "optional": true
    }
  }
}
