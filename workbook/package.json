{
  "name": "@danielsimonjr/mathts-workbook",
  "version": "0.4.0",
  "description": "Scientific workbook runtime for MathTS (.mtsw format)",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mtsw": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsup --minify --treeshake"
  },
  "dependencies": {
    "@danielsimonjr/mathts-core": "^0.14.1",
    "@danielsimonjr/mathts-expression": "^0.7.1",
    "@danielsimonjr/mathts-functions": "^0.64.0",
    "@danielsimonjr/mathts-plot": "^0.4.2",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "workbook"
  },
  "keywords": [
    "notebook",
    "workbook",
    "scientific-computing",
    "reactive",
    "yaml"
  ]
}
