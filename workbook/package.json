{
  "name": "@danielsimonjr/mathts-workbook",
  "version": "0.1.8",
  "description": "Scientific workbook runtime for MathTS (.mtsw format)",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mtsw": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsup src/index.ts src/cli.ts --format esm --dts --clean --minify --treeshake"
  },
  "dependencies": {
    "@danielsimonjr/mathts-core": "^0.10.0",
    "@danielsimonjr/mathts-expression": "^0.6.4",
    "@danielsimonjr/mathts-functions": "^0.26.0",
    "@danielsimonjr/mathts-plot": "^0.3.10",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/mathts",
    "directory": "workbook"
  },
  "keywords": [
    "notebook",
    "workbook",
    "scientific-computing",
    "reactive",
    "yaml"
  ]
}
