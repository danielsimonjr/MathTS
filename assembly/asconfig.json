{
  "targets": {
    "debug": {
      "outFile": "build/mathts-debug.wasm",
      "textFile": "build/mathts-debug.wat",
      "sourceMap": true,
      "debug": true
    },
    "release": {
      "outFile": "build/mathts.wasm",
      "textFile": "build/mathts.wat",
      "sourceMap": false,
      "optimizeLevel": 3,
      "shrinkLevel": 1,
      "converge": false,
      "noAssert": true
    }
  },
  "options": {
    "bindings": "esm",
    "exportRuntime": true,
    "runtime": "stub",
    "enable": ["simd", "bulk-memory", "reference-types"],
    "use": "abort=src/env/abort"
  }
}
