version: "1.0"

metadata:
  title: "Basic MathTS Workbook"
  author: "MathTS"
  description: "Expression-style .mtsw demonstrating code, dependencies, data, and self-verifying test cells."
  tags: [example, tutorial, basics]

runtime:
  engine: mathts
  execution: reactive

cells:
  - markdown: |
      # Basic MathTS Workbook

      This workbook demonstrates the headless `.mtsw` runtime:

      - **code** cells evaluate MathTS expressions
      - cells reference each other by id via **depends_on**
      - **data** cells hold structured YAML
      - **test** cells assert results (they make the workbook self-verifying)

      Run it with: `mtsw run examples/basic-workbook.mtsw`
    id: intro

  - markdown: |
      ## Gauss sum

      The sum of the first `n` natural numbers is `n(n+1)/2`.
    id: gaussIntro

  - code: "10"
    id: n

  - code: "n * (n + 1) / 2"
    id: gaussSum
    depends_on: [n]

  - test: "gaussSum == 55"
    id: checkGauss
    depends_on: [gaussSum]

  - markdown: |
      ## Object results & property access

      A code cell can return multiple named values as an object; downstream
      cells read them with sandboxed property access.
    id: objectIntro

  - code: "{ pi: 3.14159265359, e: 2.71828182846 }"
    id: constants

  - test: "constants.pi > 3.14"
    id: checkPi
    depends_on: [constants]

  - markdown: |
      ## Numeric check

      `sqrt(2)` squared returns to 2 within floating-point tolerance.
    id: rootIntro

  - code: "sqrt(2)"
    id: root2

  - test: "abs(root2 * root2 - 2) < 1e-9"
    id: checkRoot2
    depends_on: [root2]

  - markdown: |
      ## Data cells

      Data cells hold structured YAML, parsed into a value at run time.
    id: dataIntro

  - data: |
      label: "demo dataset"
      values: [1, 2, 3, 4]
    id: dataset
