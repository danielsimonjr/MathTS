{
  "name": "mathts",
  "version": "0.1.0",
  "packageManager": "npm@10.2.0",
  "description": "A high-performance TypeScript mathematics library with WASM/WebGPU/WebWorker acceleration",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "core",
    "matrix",
    "functions",
    "expression",
    "parallel",
    "workbook"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/mathts"
  },
  "bugs": {
    "url": "https://github.com/danielsimonjr/mathts/issues"
  },
  "homepage": "https://github.com/danielsimonjr/mathts#readme",
  "keywords": [
    "math",
    "mathematics",
    "typescript",
    "wasm",
    "webgpu",
    "matrix",
    "tensor",
    "linear-algebra",
    "scientific-computing",
    "physics"
  ]
}
