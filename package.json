{
  "name": "mathts",
  "version": "0.1.0",
  "packageManager": "npm@10.2.0",
  "description": "A high-performance TypeScript mathematics library with WASM/WebGPU/WebWorker acceleration",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "core",
    "matrix",
    "tensor",
    "autograd",
    "functions",
    "expression",
    "parser",
    "units",
    "numbers",
    "ast",
    "evaluator",
    "linalg",
    "arithmetic",
    "trigonometry",
    "statistics",
    "signal",
    "parallel",
    "workbook",
    "assembly",
    "compat",
    "gpu",
    "plot"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:wasm": "npm run asbuild -w @danielsimonjr/mathts-wasm",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:browser": "vitest --config vitest.config.browser.ts",
    "test:wasm": "npm run test -w @danielsimonjr/mathts-wasm",
    "test:wasm:integration": "vitest run tests/wasm/",
    "test:coverage": "turbo run test:coverage",
    "bench:parallel": "npx tsx tools/benchmark/parallel/run.ts",
    "bench:tensor": "npx tsx tools/benchmark/tensor/contract.bench.ts && npx tsx tools/benchmark/tensor/contract-network.bench.ts && npx tsx tools/benchmark/tensor/tensordot.bench.ts && npx tsx tools/benchmark/tensor/decompositions.bench.ts",
    "bench:wasm": "npx tsx tools/benchmark/wasm/run.ts",
    "bench:elementwise": "npx tsx tools/benchmark/wasm/elementwise.bench.ts",
    "bench:special": "npx tsx tools/benchmark/wasm/special.bench.ts",
    "bench:sort": "npx tsx tools/benchmark/wasm/sort.bench.ts",
    "bench:matrix": "npx tsx tools/benchmark/wasm/matrix.bench.ts",
    "bench:backends:build": "npx esbuild tools/benchmark/gpu/bench-3way.entry.ts --bundle --platform=browser --format=esm --outfile=tools/benchmark/gpu/bench-3way.bundle.js --external:fs --external:util --external:url --external:node:url --external:crypto --external:path --external:node:fs --external:node:path --external:node:crypto --external:node:util",
    "bench:backends:serve": "npm run bench:backends:build && npx http-server . -p 8099 -c-1 -s -o /tools/benchmark/gpu/bench-3way.html",
    "precommit:refresh": "npm run build:wasm && npm run docs:deps",
    "docs:deps": "npx tsx tools/create-dependency-graph/create-dependency-graph.ts --root=. && npm run docs:deps:derive && npm run docs:deps:format",
    "docs:deps:derive": "node tools/query-dependency-graph/query-dependency-graph.mjs --emit",
    "docs:deps:format": "prettier --write docs/Architecture/DEPENDENCY_GRAPH.md docs/Architecture/unused-analysis.md docs/Architecture/wasm-pairing.md docs/Architecture/dependency-graph.json docs/Architecture/dependency-graph.yaml docs/Architecture/dependency-summary.compact.json docs/Architecture/package-export-surfaces.json docs/Architecture/wasm-pairing.json docs/Architecture/parallel-pairing.md docs/Architecture/parallel-pairing.json docs/Architecture/dependency-reverse.json docs/Architecture/node-safety.json docs/Architecture/webgpu-pairing.md docs/Architecture/webgpu-pairing.json docs/Architecture/duplicate-symbols.md docs/Architecture/duplicate-symbols.json",
    "docs:duplicates": "npm run docs:deps",
    "docs:graph": "node tools/query-dependency-graph/query-dependency-graph.mjs",
    "docs:graph:test": "node --test tools/query-dependency-graph/query-dependency-graph.test.mjs",
    "check:browser-safety": "node tools/query-dependency-graph/query-dependency-graph.mjs --check-browser-safety",
    "docs:functions": "node tools/generate-functions-reference.mjs",
    "docs:roadmap-check": "node tools/roadmap-check/roadmap-check.mjs",
    "docs:roadmap-check:test": "node --test tools/roadmap-check/roadmap-check.test.mjs",
    "docs:functions:check": "node tools/generate-functions-reference.mjs --check",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "build:prod": "turbo run build:prod",
    "release": "changeset version && npm run build",
    "test:bench": "vitest run --config vitest.config.bench.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^25.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.0.0",
    "fast-check": "^4.8.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.0.0",
    "turbo": "^2.9.18",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/mathts"
  },
  "bugs": {
    "url": "https://github.com/danielsimonjr/mathts/issues"
  },
  "homepage": "https://github.com/danielsimonjr/mathts#readme",
  "keywords": [
    "math",
    "mathematics",
    "typescript",
    "wasm",
    "webgpu",
    "matrix",
    "tensor",
    "linear-algebra",
    "scientific-computing",
    "physics"
  ],
  "dependencies": {
    "typed-function": "github:danielsimonjr/typed-function",
    "workerpool": "github:danielsimonjr/workerpool"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.0"
  }
}
