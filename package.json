{
  "name": "mathts",
  "version": "0.1.0",
  "packageManager": "npm@10.2.0",
  "description": "A high-performance TypeScript mathematics library with WASM/WebGPU/WebWorker acceleration",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "core",
    "matrix",
    "tensor",
    "autograd",
    "functions",
    "expression",
    "parser",
    "units",
    "numbers",
    "ast",
    "evaluator",
    "linalg",
    "arithmetic",
    "trigonometry",
    "statistics",
    "signal",
    "parallel",
    "workbook",
    "assembly",
    "compat"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:wasm": "npm run asbuild -w @danielsimonjr/mathts-wasm",
    "build:wasm:rust": "bash wasm-rust/scripts/build.sh",
    "build:wasm:all": "npm run build:wasm && npm run build:wasm:rust",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:browser": "vitest --config vitest.config.browser.ts",
    "test:wasm": "npm run test -w @danielsimonjr/mathts-wasm",
    "test:wasm:integration": "vitest run tests/wasm/",
    "test:coverage": "turbo run test:coverage",
    "bench:wasm": "npx tsx tests/benchmark/wasm_rust_vs_as_benchmark.ts",
    "bench:parallel": "npx tsx tools/benchmark/parallel/run.ts",
    "bench:tensor": "npx tsx tools/benchmark/tensor/contract.bench.ts && npx tsx tools/benchmark/tensor/contract-network.bench.ts && npx tsx tools/benchmark/tensor/tensordot.bench.ts && npx tsx tools/benchmark/tensor/decompositions.bench.ts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "build:prod": "turbo run build:prod",
    "release": "changeset version && npm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^25.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.0.0",
    "playwright": "^1.60.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.9.18",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/mathts"
  },
  "bugs": {
    "url": "https://github.com/danielsimonjr/mathts/issues"
  },
  "homepage": "https://github.com/danielsimonjr/mathts#readme",
  "keywords": [
    "math",
    "mathematics",
    "typescript",
    "wasm",
    "webgpu",
    "matrix",
    "tensor",
    "linear-algebra",
    "scientific-computing",
    "physics"
  ],
  "dependencies": {
    "typed-function": "github:danielsimonjr/typed-function",
    "workerpool": "github:danielsimonjr/workerpool"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
