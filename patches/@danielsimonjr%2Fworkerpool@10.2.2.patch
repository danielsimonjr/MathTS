--- /dev/null
+++ b/types/consumer-node-shim.d.ts
@@ -0,0 +1,45 @@
+/**
+ * Minimal Node typings bundled with @danielsimonjr/workerpool so strict consumers
+ * can typecheck workerpool's declarations with skipLibCheck: false and no @types/node.
+ */
+declare module 'child_process' {
+  export interface ForkOptions {
+    cwd?: string;
+    env?: Record<string, string | undefined>;
+    execPath?: string;
+    silent?: boolean;
+    stdio?: unknown;
+    detached?: boolean;
+    uid?: number;
+    gid?: number;
+    serialization?: 'json' | 'advanced';
+    windowsVerbatimArguments?: boolean;
+    windowsHide?: boolean;
+    signal?: AbortSignal;
+    timeout?: number;
+    killSignal?: string | number;
+    [key: string]: unknown;
+  }
+}
+
+declare module 'worker_threads' {
+  export interface WorkerOptions {
+    env?: Record<string, string | undefined>;
+    eval?: boolean;
+    workerData?: unknown;
+    stdout?: boolean;
+    stderr?: boolean;
+    stdin?: boolean;
+    transferList?: readonly unknown[];
+    resourceLimits?: Record<string, number>;
+    trackUnmanagedFds?: boolean;
+    [key: string]: unknown;
+  }
+}
+
+declare namespace NodeJS {
+  type Timeout = ReturnType<typeof setTimeout>;
+  interface ReadableStream {
+    on(event: string, listener: (...args: unknown[]) => void): this;
+  }
+}
