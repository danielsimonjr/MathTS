// =============================================================================
// INVERSE LAPLACE TRANSFORM (CAS function)
// =============================================================================

/**
 * Compute n! for small non-negative integers.
 */
function iltFactorial(n: number): f64 {
  if (n <= 1) return 1;
  let result: f64 = 1;
  for (let i = 2; i <= n; i++) result *= i;
  return result;
}

/**
 * Greatest common divisor.
 */
function iltGcd(a: number, b: number): number {
  a = Math.abs(Math.round(a));
  b = Math.abs(Math.round(b));
  while (b !== 0) {
    const tmp = b;
    b = a % b;
    a = tmp;
  }
  return a;
}

/**
 * Format a number as a nice string (integer if close to integer, otherwise decimal).
 */
function iltNiceNumber(val: f64): string {
  const rounded = Math.round(val);
  if (Math.abs(val - rounded) < 1e-8) return String(rounded);
  for (let den = 2; den <= 12; den++) {
    const num = Math.round(val * den);
    if (Math.abs(val - num / den) < 1e-8) {
      const g = iltGcd(Math.abs(num), den);
      const n = num / g;
      const d = den / g;
      return d === 1 ? String(n) : `${n}/${d}`;
    }
  }
  return val.toPrecision(6);
}

/**
 * Numerically evaluate an expression at a given variable value.
 */
function iltEvalAt(expr: string, varName: string, val: f64): f64 | null {
  try {
    const result = evaluate(expr, { [varName]: val }) as f64;
    if (typeof result === 'number' && isFinite(result)) return result;
    return null;
  } catch {
    return null;
  }
}

/**
 * Check if node string matches a simple pattern by numerical evaluation.
 */
function iltMatchPattern(exprStr: string, varName: string, pattern: string): boolean {
  const checkStr = pattern.replace(/\bs\b/g, varName);
  const testPoints = [2, 3, 5, 7, 11];
  for (const p of testPoints) {
    const v1 = iltEvalAt(exprStr, varName, p);
    const v2 = iltEvalAt(checkStr, varName, p);
    if (v1 === null || v2 === null) return false;
    if (Math.abs(v1 - v2) > 1e-9) return false;
  }
  return true;
}

/**
 * Match s/(s^2 + b^2) → cos(b*t), b/(s^2 + b^2) → sin(b*t),
 * s/(s^2 - a^2) → cosh(a*t), a/(s^2 - a^2) → sinh(a*t)
 */
function iltMatchQuadratic(exprStr: string, s: string, t: string): string | null {
  const v2 = iltEvalAt(exprStr, s, 2);
  const v3 = iltEvalAt(exprStr, s, 3);
  const v5 = iltEvalAt(exprStr, s, 5);
  if (v2 === null || v3 === null || v5 === null) return null;

  if (Math.abs(v2) > 1e-12 && Math.abs(v3) > 1e-12) {
    const b2fromV2 = 2 / v2 - 4;
    const b2fromV3 = 3 / v3 - 9;

    // s/(s^2 + b^2) → cos(b*t)
    if (b2fromV2 > 0 && Math.abs(b2fromV2 - b2fromV3) < 1e-6) {
      const b = Math.sqrt(b2fromV2);
      const expected = 5 / (25 + b2fromV2);
      if (Math.abs(v5 - expected) < 1e-8) {
        const bStr = iltNiceNumber(b);
        return `cos(${bStr} * ${t})`;
      }
    }

    // s/(s^2 - a^2) → cosh(a*t)
    const a2fromV2 = 4 - 2 / v2;
    const a2fromV3 = 9 - 3 / v3;
    if (a2fromV2 > 0 && Math.abs(a2fromV2 - a2fromV3) < 1e-6) {
      const a = Math.sqrt(a2fromV2);
      const expected = 5 / (25 - a2fromV2);
      if (isFinite(expected) && Math.abs(v5 - expected) < 1e-8) {
        const aStr = iltNiceNumber(a);
        return `cosh(${aStr} * ${t})`;
      }
    }
  }

  // c/(s^2 + b^2) → (c/b)*sin(b*t)
  if (Math.abs(v2 - v3) > 1e-12) {
    const b2 = (9 * v3 - 4 * v2) / (v2 - v3);
    if (b2 > 0) {
      const c = v2 * (4 + b2);
      const b = Math.sqrt(b2);
      const expected = c / (25 + b2);
      if (Math.abs(v5 - expected) < 1e-8) {
        const coeff = c / b;
        const bStr = iltNiceNumber(b);
        const coeffStr = iltNiceNumber(coeff);
        if (Math.abs(coeff - 1) < 1e-8) {
          return `sin(${bStr} * ${t})`;
        }
        return `${coeffStr} * sin(${bStr} * ${t})`;
      }
    }

    // c/(s^2 - a^2) → (c/a)*sinh(a*t)
    const a2sinh = (9 * v3 - 4 * v2) / (v3 - v2);
    if (a2sinh > 0) {
      const c2 = v2 * (4 - a2sinh);
      const a = Math.sqrt(a2sinh);
      const expected2 = c2 / (25 - a2sinh);
      if (isFinite(expected2) && Math.abs(v5 - expected2) < 1e-8) {
        const coeff = c2 / a;
        const aStr = iltNiceNumber(a);
        const coeffStr = iltNiceNumber(coeff);
        if (Math.abs(coeff - 1) < 1e-8) {
          return `sinh(${aStr} * ${t})`;
        }
        return `${coeffStr} * sinh(${aStr} * ${t})`;
      }
    }
  }

  return null;
}

/**
 * Match c/s^n → c * t^(n-1) / (n-1)! for integer n >= 1
 */
function iltMatchPower(exprStr: string, s: string, t: string): string | null {
  const v2 = iltEvalAt(exprStr, s, 2);
  if (v2 === null || Math.abs(v2) < 1e-15) return null;

  for (let n = 1; n <= 10; n++) {
    const testVal = Math.pow(2, n) * v2;
    const v3 = iltEvalAt(exprStr, s, 3);
    const v5 = iltEvalAt(exprStr, s, 5);
    if (v3 === null || v5 === null) return null;

    const c3 = Math.pow(3, n) * v3;
    const c5 = Math.pow(5, n) * v5;

    if (Math.abs(testVal - c3) < 1e-8 && Math.abs(testVal - c5) < 1e-8) {
      const c = testVal;
      const fact = iltFactorial(n - 1);
      const coeff = c / fact;
      if (n === 1) {
        const coeffStr = iltNiceNumber(coeff);
        return Math.abs(coeff - 1) < 1e-8 ? '1' : coeffStr;
      }
      if (n === 2) {
        const coeffStr = iltNiceNumber(coeff);
        return Math.abs(coeff - 1) < 1e-8 ? t : `${coeffStr} * ${t}`;
      }
      const power = n - 1;
      const coeffStr = iltNiceNumber(coeff);
      const term = `${t}^${power}`;
      return Math.abs(coeff - 1) < 1e-8 ? term : `${coeffStr} * ${term}`;
    }
  }

  return null;
}

/**
 * Match 1/(s - a) → e^(a*t)
 */
function iltMatchExponential(exprStr: string, s: string, t: string): string | null {
  const v3 = iltEvalAt(exprStr, s, 3);
  const v5 = iltEvalAt(exprStr, s, 5);
  const v7 = iltEvalAt(exprStr, s, 7);
  if (v3 === null || v5 === null || v7 === null) return null;
  if (Math.abs(v3) < 1e-15) return null;

  const aFromV3 = 3 - 1 / v3;
  const aFromV5 = 5 - 1 / v5;
  const aFromV7 = 7 - 1 / v7;

  if (Math.abs(aFromV3 - aFromV5) < 1e-8 && Math.abs(aFromV3 - aFromV7) < 1e-8) {
    const a = aFromV3;
    const aStr = iltNiceNumber(a);
    if (Math.abs(a) < 1e-8) {
      return 'e^(0)';
    }
    if (a > 0) {
      return `e^(${aStr} * ${t})`;
    } else {
      const absA = iltNiceNumber(-a);
      return `e^(-${absA} * ${t})`;
    }
  }

  return null;
}

/**
 * Match c/(s - a) → c * e^(a*t)
 */
function iltMatchScaledExponential(exprStr: string, s: string, t: string): string | null {
  const s1 = 3, s2 = 5, s3 = 7;
  const v1 = iltEvalAt(exprStr, s, s1);
  const v2 = iltEvalAt(exprStr, s, s2);
  const v3 = iltEvalAt(exprStr, s, s3);
  if (v1 === null || v2 === null || v3 === null) return null;
  if (Math.abs(v2 - v1) < 1e-12) return null;

  const a = (s2 * v2 - s1 * v1) / (v2 - v1);
  const c = v1 * (s1 - a);

  const expected = c / (s3 - a);
  if (!isFinite(expected) || Math.abs(v3 - expected) > 1e-8) return null;
  if (Math.abs(c) < 1e-12) return null;

  const aStr = iltNiceNumber(a);
  const cStr = iltNiceNumber(c);

  let expPart: string;
  if (Math.abs(a) < 1e-8) {
    expPart = '1';
  } else if (a > 0) {
    expPart = `e^(${aStr} * ${t})`;
  } else {
    const absA = iltNiceNumber(-a);
    expPart = `e^(-${absA} * ${t})`;
  }

  if (Math.abs(c - 1) < 1e-8) {
    return expPart;
  }
  if (Math.abs(a) < 1e-8) {
    return cStr;
  }
  return `${cStr} * ${expPart}`;
}

/**
 * Table lookup for known Laplace transform pairs.
 */
function iltTableLookup(exprStr: string, s: string, t: string): string | null {
  // 1/s → 1 (unit step)
  if (iltMatchPattern(exprStr, s, '1/s')) return '1';

  // 1/s^2 → t
  if (iltMatchPattern(exprStr, s, '1/s^2')) return t;

  // Quadratic patterns: cos, sin, cosh, sinh
  const quadResult = iltMatchQuadratic(exprStr, s, t);
  if (quadResult !== null) return quadResult;

  // Power: c/s^n
  const powerResult = iltMatchPower(exprStr, s, t);
  if (powerResult !== null) return powerResult;

  // Exponential: 1/(s - a)
  const expResult = iltMatchExponential(exprStr, s, t);
  if (expResult !== null) return expResult;

  // Scaled exponential: c/(s - a)
  const scaledExpResult = iltMatchScaledExponential(exprStr, s, t);
  if (scaledExpResult !== null) return scaledExpResult;

  return null;
}

/**
 * Recursively apply inverse Laplace to an expression string.
 * Handles sums and differences by transforming each term independently.
 */
function iltRecursive(exprStr: string, s: string, t: string): string {
  const trimmed = exprStr.trim();

  // Try direct table lookup first
  const direct = iltTableLookup(trimmed, s, t);
  if (direct !== null) return direct;

  // Try to detect addition/subtraction at the top level by evaluating
  // We use a simple structural approach: try to split on + or - at top level
  // by scanning for operators not inside parentheses
  const split = iltSplitTopLevel(trimmed);
  if (split !== null) {
    const { left, op, right } = split;
    const leftResult = iltRecursive(left, s, t);
    const rightResult = iltRecursive(right, s, t);
    return `${leftResult} ${op} ${rightResult}`;
  }

  throw new Error(
    `inverseLaplaceTransform: could not find inverse Laplace transform for "${trimmed}". Pattern not recognized in lookup table.`
  );
}

/**
 * Split an expression string on a top-level + or - operator.
 * Returns null if no such split is found.
 */
function iltSplitTopLevel(expr: string): { left: string; op: string; right: string } | null {
  let depth = 0;
  // Scan right-to-left to find the last top-level + or -
  for (let i = expr.length - 1; i >= 0; i--) {
    const ch = expr[i];
    if (ch === ')') depth++;
    else if (ch === '(')