{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // TypeScript 7 does not auto-include node_modules/@types; a package that
    // typechecks without this is relying on a dependency shipping its own node
    // reference, which a bump can remove.
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@danielsimonjr/mathts-core": ["core/src"],
      "@danielsimonjr/mathts-matrix": ["matrix/src"],
      "@danielsimonjr/mathts-workbook": ["workbook/src"]
    }
  },
  "references": [],
  "include": [],
  "exclude": ["node_modules", "dist", "**/dist"]
}
