# Keep the two generated-but-committed artifacts current before every commit, then lint staged
# files. Husky runs this via `sh -e`, so any failure aborts the commit. Bypass with
# `git commit --no-verify` only when explicitly authorized.
#
# Both refresh steps are GATED on what the commit actually touches — running `build:wasm` (asc
# debug+release+manifest, ~1-2 min) on every commit is too slow and pure waste on a doc/test-only
# commit (the binary and reports are pure functions of source, so they don't change). So:
#   - WB (build:wasm): only when `assembly/` source changed — the only input to the .wasm binary
#     and its wasm-pairing report.
#   - DGT (docs:deps): only when any package `src/` (or `assembly/`) changed — imports/exports are
#     what drive the dependency graph. Regenerated reports are staged into the commit.
#   - FNREF (docs:functions): same gate — the function/export reference (docs/api/*.md,
#     docs/reference/functions.md[.html]) is a pure function of the exported surface, so a `src/`
#     change can leave it stale (GC2). Regenerate + stage so it never drifts (~8s, build-free).
# A commit touching only docs/tests/config skips all and just runs lint-staged.

staged=$(git diff --cached --name-only)

if printf '%s\n' "$staged" | grep -q '^assembly/'; then
  echo "pre-commit: assembly/ changed → rebuilding WASM (build:wasm)"
  npm run build:wasm
fi

if printf '%s\n' "$staged" | grep -qE '(^|/)src/|^assembly/'; then
  echo "pre-commit: source changed → regenerating dependency-graph reports (docs:deps)"
  npm run docs:deps
  git add docs/Architecture
  echo "pre-commit: source changed → regenerating function reference (docs:functions)"
  npm run docs:functions
  git add docs/api docs/reference
elif printf '%s\n' "$staged" | grep -qE '\.ts$'; then
  # Non-src .ts changed (tests/docs/tools/config). The FILE CENSUS (file-inventory.json) tracks EVERY
  # tracked .ts, so adding/removing a test/doc/tool .ts leaves it stale even though the module graph
  # is unchanged. Regenerate docs:deps (which rebuilds the census) so it stays current. docs:functions
  # is NOT re-run here — the exported surface only changes with src/. (Build-free, ~10-20s.)
  echo "pre-commit: non-src .ts changed → regenerating dependency-graph + file census (docs:deps)"
  npm run docs:deps
  git add docs/Architecture
fi

# CENSUS GATE (check:file-census): the file-inventory self-check — fails the commit if any tracked .ts
# on disk is unaccounted for in docs/Architecture/file-inventory.json (a discovery/scoping gap or a
# stale census). Runs on EVERY commit; it's a maximal disk walk + compare, no graph rebuild (<1s). The
# regen steps above keep the census fresh; this is the loud backstop that a gap can never slip past.
echo "pre-commit: verifying complete file census (check:file-census)"
npm run check:file-census

# DUPGATE (check:duplicates:fast): prevention gate for the cross-package duplicate-symbols
# campaign — fails the commit if it introduces a NEW TRUE_DUPLICATE beyond
# docs/Architecture/duplicate-baseline.json (the campaign's shrinking, already-accepted backlog).
# Runs on EVERY commit (not gated on the src/ check above) since it's just a JSON read + diff, not
# a regen: `--no-regen` reads docs/Architecture/duplicate-symbols.json as-is, which the DGT step
# above already refreshed when src/ changed (and is untouched, hence still correct, when it
# didn't) — so this never triggers a second docs:deps/build:wasm run. Adds well under a second.
echo "pre-commit: checking for new cross-package duplicate symbols (check:duplicates:fast)"
npm run check:duplicates:fast

npx lint-staged
