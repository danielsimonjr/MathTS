# Keep the two generated-but-committed artifacts current before every commit, then lint staged
# files. Husky runs this via `sh -e`, so any failure aborts the commit. Bypass with
# `git commit --no-verify` only when explicitly authorized.
#
# Both refresh steps are GATED on what the commit actually touches — running `build:wasm` (asc
# debug+release+manifest, ~1-2 min) on every commit is too slow and pure waste on a doc/test-only
# commit (the binary and reports are pure functions of source, so they don't change). So:
#   - WB (build:wasm): only when `assembly/` source changed — the only input to the .wasm binary
#     and its wasm-pairing report.
#   - DGT (docs:deps): only when any package `src/` (or `assembly/`) changed — imports/exports are
#     what drive the dependency graph. Regenerated reports are staged into the commit.
#   - FNREF (docs:functions): same gate — the function/export reference (docs/api/*.md,
#     docs/reference/functions.md[.html]) is a pure function of the exported surface, so a `src/`
#     change can leave it stale (GC2). Regenerate + stage so it never drifts (~8s, build-free).
# A commit touching only docs/tests/config skips all and just runs lint-staged.

staged=$(git diff --cached --name-only)

if printf '%s\n' "$staged" | grep -q '^assembly/'; then
  echo "pre-commit: assembly/ changed → rebuilding WASM (build:wasm)"
  npm run build:wasm
fi

if printf '%s\n' "$staged" | grep -qE '(^|/)src/|^assembly/'; then
  echo "pre-commit: source changed → regenerating dependency-graph reports (docs:deps)"
  npm run docs:deps
  git add docs/Architecture
  echo "pre-commit: source changed → regenerating function reference (docs:functions)"
  npm run docs:functions
  git add docs/api docs/reference
fi

npx lint-staged
