# Keep the generated function reference current before every commit, run the census and duplicate
# gates, then lint staged files. Husky runs this via `sh -e`, so any failure aborts the commit.
# Bypass with `git commit --no-verify` only when explicitly authorized.
#
# The dependency-graph reports of docs/Architecture (`bun run docs:deps`) are generated and are
# not committed: .gitignore names each of them. So no step below stages docs/Architecture, and two
# pull requests that change source no longer conflict in those reports. docs/api and docs/reference
# stay committed, and the steps for them stage their files.
#
# Both refresh steps are GATED on what the commit actually touches — running `build:wasm` (asc
# debug+release+manifest, ~1-2 min) on every commit is too slow and pure waste on a doc/test-only
# commit (the binary and reports are pure functions of source, so they don't change). So:
#   - WB (build:wasm): only when `assembly/` source changed — the only input to the .wasm binary
#     and its wasm-pairing report.
#   - DGT (docs:deps): only when any package `src/` (or `assembly/`) changed — imports/exports are
#     what drive the dependency graph. It writes the generated reports and runs the file-census
#     self-check (`verifyFileCensus`), which exits non-zero on any gap.
#   - DUPGATE (check:duplicates:fast): directly after docs:deps, on the report that docs:deps wrote.
#   - LOCK (check-export-lock): same gate as DGT; compares the built exports to the lock.
#   - FNREF (docs:functions): same gate — the generator refuses a missing/stale dist and exits
#     before rewriting docs/api or docs/reference; `sh -e` aborts the commit. Rebuild that package
#     and commit again. Still ~8s and build-free when dist is fresh.
# A commit that changes another .ts file (tests, tools, config) or the coverage policy runs
# docs:deps and the duplicate gate only: the file census and TEST_COVERAGE.md read those files. A
# commit with no such file skips these steps: it adds no .ts file and no symbol, so the census and
# the duplicate report cannot change.

staged=$(git diff --cached --name-only)

if printf '%s\n' "$staged" | grep -q '^assembly/'; then
  echo "pre-commit: assembly/ changed → rebuilding WASM (build:wasm)"
  bun run build:wasm
fi

if printf '%s\n' "$staged" | grep -qE '(^|/)src/|^assembly/'; then
  echo "pre-commit: source changed → regenerating dependency-graph reports (docs:deps)"
  bun run docs:deps
  # DUPGATE: prevention gate for the cross-package duplicate-symbols campaign — fails the commit if
  # it introduces a NEW TRUE_DUPLICATE beyond docs/Architecture/duplicate-baseline.json (the
  # campaign's shrinking, already-accepted backlog). `--no-regen` reads the duplicate-symbols.json
  # that docs:deps wrote one line above, so this adds well under a second and no second docs:deps
  # run. It runs before docs:functions, so a new duplicate fails on its own message.
  echo "pre-commit: checking for new cross-package duplicate symbols (check:duplicates:fast)"
  bun run check:duplicates:fast
  echo "pre-commit: source changed → regenerating function reference (docs:functions)"
  bun run docs:functions
  git add docs/api docs/reference
  # EXPORT LOCK (check-export-lock): the public export names of every published package must
  # match tools/test/export-lock.json. CI runs the same check in the Test (22.x) job. It reads
  # the built dist, which docs:functions above already requires to be fresh, so it runs only
  # here, where src/ changed. For a deliberate export change, run
  # `node tools/test/check-export-lock.mjs --write` and stage the lock.
  echo "pre-commit: source changed → checking the public export-name lock (check-export-lock)"
  node tools/test/check-export-lock.mjs
elif printf '%s\n' "$staged" | grep -qE '\.ts$|^docs/Architecture/coverage-policy\.json$'; then
  # Non-src .ts changed (tests/docs/tools/config). The FILE CENSUS (file-inventory.json) tracks EVERY
  # tracked .ts, so adding/removing a test/doc/tool .ts changes it even though the module graph is
  # unchanged, and docs:deps fails the commit if the census and the repo disagree.
  # TEST_COVERAGE.md reads the test files and docs/Architecture/coverage-policy.json. docs:functions
  # is NOT re-run here — the exported surface only changes with src/. (Build-free, ~10-20s.)
  echo "pre-commit: non-src .ts changed → regenerating dependency-graph + file census (docs:deps)"
  bun run docs:deps
  echo "pre-commit: checking for new cross-package duplicate symbols (check:duplicates:fast)"
  bun run check:duplicates:fast
fi

bunx lint-staged
