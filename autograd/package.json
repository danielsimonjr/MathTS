{
  "name": "@danielsimonjr/mathts-autograd",
  "version": "0.3.20",
  "description": "Forward + reverse-mode automatic differentiation for MathTS rank-N Tensor",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm && tsc -p tsconfig.dts.json",
    "dev": "tsdown src/index.ts --format esm --watch --on-success \"tsc -p tsconfig.dts.json\"",
    "test": "bun test --isolate --timeout 30000",
    "test:watch": "vitest",
    "test:coverage": "bun test --isolate --timeout 30000 --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsdown src/index.ts --format esm --minify && tsc -p tsconfig.dts.json"
  },
  "tsdown": {
    "fixedExtension": false,
    "dts": false,
    "outputOptions": {
      "comments": {
        "legal": true,
        "annotation": true,
        "jsdoc": false
      }
    }
  },
  "dependencies": {
    "@danielsimonjr/mathts-core": "^0.20.0",
    "@danielsimonjr/mathts-tensor": "^0.2.26"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "autograd"
  },
  "keywords": [
    "math",
    "autograd",
    "automatic-differentiation",
    "tensor",
    "typescript"
  ]
}
