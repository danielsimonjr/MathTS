{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "@danielsimonjr/mathts-matrix#build": {
      "dependsOn": ["^build", "@danielsimonjr/mathts-wasm#build"],
      "outputs": ["dist/**", "build/**"]
    },
    "@danielsimonjr/mathts-functions#build": {
      "dependsOn": ["^build", "@danielsimonjr/mathts-wasm#build"],
      "outputs": ["dist/**", "build/**"]
    },
    "build:prod": {
      "dependsOn": ["^build:prod"],
      "outputs": ["dist/**"]
    },
    "@danielsimonjr/mathts-matrix#build:prod": {
      "dependsOn": ["^build:prod", "@danielsimonjr/mathts-wasm#build"],
      "outputs": ["dist/**"]
    },
    "@danielsimonjr/mathts-functions#build:prod": {
      "dependsOn": ["^build:prod", "@danielsimonjr/mathts-wasm#build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
