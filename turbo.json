{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tools/ensure-js-sourcemaps.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "@danielsimonjr/mathts-matrix#build": {
      "dependsOn": ["^build", "@danielsimonjr/mathts-wasm#build"],
      "outputs": ["dist/**", "build/**"]
    },
    "@danielsimonjr/mathts-functions#build": {
      "dependsOn": ["^build", "@danielsimonjr/mathts-wasm#build"],
      "outputs": ["dist/**", "build/**"]
    },
    "build:prod": {
      "dependsOn": ["^build:prod"],
      "outputs": ["dist/**"]
    },
    "@danielsimonjr/mathts-matrix#build:prod": {
      "dependsOn": ["^build:prod", "@danielsimonjr/mathts-wasm#build"],
      "outputs": ["dist/**"]
    },
    "@danielsimonjr/mathts-functions#build:prod": {
      "dependsOn": ["^build:prod", "@danielsimonjr/mathts-wasm#build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"]
    },
    "@danielsimonjr/mathts-functions#test": {
      "dependsOn": [
        "^build",
        "build",
        "@danielsimonjr/mathts-compat#build",
        "@danielsimonjr/mathts-statistics#build",
        "@danielsimonjr/mathts-trigonometry#build",
        "@danielsimonjr/mathts-units#build",
        "@danielsimonjr/mathts-arithmetic#build"
      ],
      "outputs": []
    },
    "@danielsimonjr/mathts-functions#test:coverage": {
      "dependsOn": [
        "^build",
        "build",
        "@danielsimonjr/mathts-compat#build",
        "@danielsimonjr/mathts-statistics#build",
        "@danielsimonjr/mathts-trigonometry#build",
        "@danielsimonjr/mathts-units#build",
        "@danielsimonjr/mathts-arithmetic#build"
      ],
      "outputs": ["coverage/**"]
    },
    "@danielsimonjr/mathts-expression#test": {
      "dependsOn": ["^build", "build", "@danielsimonjr/mathts-functions#build"],
      "outputs": []
    },
    "@danielsimonjr/mathts-expression#test:coverage": {
      "dependsOn": ["^build", "build", "@danielsimonjr/mathts-functions#build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "@danielsimonjr/mathts-expression#typecheck": {
      "dependsOn": [
        "^build",
        "build",
        "@danielsimonjr/mathts-matrix#build",
        "@danielsimonjr/mathts-functions#build"
      ],
      "outputs": []
    },
    "@danielsimonjr/mathts-functions#typecheck": {
      "dependsOn": [
        "^build",
        "build",
        "@danielsimonjr/mathts-compat#build",
        "@danielsimonjr/mathts-statistics#build",
        "@danielsimonjr/mathts-trigonometry#build",
        "@danielsimonjr/mathts-units#build",
        "@danielsimonjr/mathts-arithmetic#build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
