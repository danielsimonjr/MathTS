{
  "remote": "origin",
  "base": "main",
  "union": ["CHANGELOG.md", "TODO.md"],
  "takeBase": [
    "docs/Architecture/OVERVIEW.md",
    "docs/Architecture/ARCHITECTURE.md",
    "docs/Architecture/COMPONENTS.md",
    "docs/Architecture/DATAFLOW.md",
    "docs/Architecture/API.md",
    "docs/Architecture/WASM_ACCELERATION.md",
    "docs/Architecture/FILE_INVENTORY.md",
    "docs/Architecture/file-inventory.json",
    "docs/Architecture/TEST_COVERAGE.md",
    "docs/Architecture/DEPENDENCY_GRAPH.md",
    "docs/Architecture/dependency-graph.json",
    "docs/Architecture/dependency-graph.yaml",
    "docs/Architecture/dependency-summary.compact.json",
    "docs/Architecture/dependency-reverse.json",
    "docs/Architecture/node-safety.json",
    "docs/Architecture/package-export-surfaces.json",
    "docs/Architecture/unused-analysis.md",
    "docs/Architecture/duplicate-symbols.json",
    "docs/Architecture/duplicate-symbols.md",
    "docs/Architecture/wasm-pairing.json",
    "docs/Architecture/wasm-pairing.md",
    "docs/Architecture/parallel-pairing.json",
    "docs/Architecture/parallel-pairing.md",
    "docs/Architecture/webgpu-pairing.json",
    "docs/Architecture/webgpu-pairing.md",
    "docs/api/**",
    "docs/reference/**",
    "tools/test/bundle-budget.json"
  ],
  "regen": [
    ["bun", "run", "build"],
    ["bun", "run", "docs:deps"],
    ["bun", "run", "docs:functions"]
  ],
  "check": [
    ["node", "tools/test/check-bundle-budget.mjs"],
    ["bun", "x", "@danielsimonjr/repo-tools@2.2.4", "check", ".", "--docs=docs/Architecture"]
  ],
  "message": "chore: merge {base}"
}
