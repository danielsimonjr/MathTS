{
  "remote": "origin",
  "base": "main",
  "union": ["CHANGELOG.md", "TODO.md"],
  "takeBase": [
    "docs/api/compat.md",
    "docs/api/core.md",
    "docs/api/expression.md",
    "docs/api/functions.md",
    "docs/api/matrix.md",
    "docs/api/parallel.md",
    "docs/api/plot.md",
    "docs/api/workbook.md",
    "docs/reference/functions.html",
    "docs/reference/functions.md",
    "tools/test/bundle-budget.json"
  ],
  "regen": [
    ["bun", "run", "build"],
    ["bun", "run", "docs:deps"],
    ["bun", "run", "docs:functions"]
  ],
  "check": [
    ["node", "tools/test/check-bundle-budget.mjs"],
    ["bun", "x", "@danielsimonjr/repo-tools@2.2.4", "check", ".", "--docs=docs/Architecture"]
  ],
  "message": "chore: merge {base}"
}
