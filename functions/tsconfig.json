{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "lib": ["ES2023", "DOM"],
    "types": ["@webgpu/types", "node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@danielsimonjr/mathts-core": ["../core/src"],
      "@danielsimonjr/mathts-expression": ["../expression/src"],
      "@danielsimonjr/mathts-matrix": ["../matrix/src"],
      "@danielsimonjr/mathts-parallel": ["../parallel/src"],
      "workerpool": ["../parallel/types/workerpool.d.ts"]
    }
  },
  "include": ["src/index.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
