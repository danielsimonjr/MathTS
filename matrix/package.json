{
  "name": "@danielsimonjr/mathts-matrix",
  "version": "0.10.1",
  "description": "Matrix operations for MathTS with WASM/WebGPU backend support",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm && tsc -p tsconfig.dts.json && node scripts/copy-wasm.mjs && node ../tools/ensure-js-sourcemaps.mjs",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "dev": "tsdown src/index.ts --format esm --watch --on-success \"tsc -p tsconfig.dts.json && node scripts/copy-wasm.mjs && node ../tools/ensure-js-sourcemaps.mjs\"",
    "test": "bun test --isolate --timeout 30000",
    "test:watch": "vitest",
    "test:coverage": "bun test --isolate --timeout 30000 --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsdown src/index.ts --format esm --minify && tsc -p tsconfig.dts.json && node scripts/copy-wasm.mjs && node ../tools/ensure-js-sourcemaps.mjs"
  },
  "tsdown": {
    "fixedExtension": false,
    "dts": false,
    "outputOptions": {
      "comments": {
        "legal": true,
        "annotation": true,
        "jsdoc": false
      }
    },
    "sourcemap": true
  },
  "dependencies": {
    "@danielsimonjr/mathts-core": "^0.27.0",
    "@danielsimonjr/mathts-gpu": "^0.3.0",
    "@danielsimonjr/mathts-parallel": "^0.10.1"
  },
  "devDependencies": {
    "ml-matrix": "^6.15.1",
    "@types/node": "^26.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "@webgpu/types": "^0.1.72"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "matrix"
  },
  "keywords": [
    "math",
    "matrix",
    "linear-algebra",
    "typescript",
    "wasm",
    "webgpu"
  ],
  "homepage": "https://github.com/danielsimonjr/MathTS#readme",
  "bugs": {
    "url": "https://github.com/danielsimonjr/MathTS/issues"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=22.12"
  }
}
