{
  "name": "@danielsimonjr/mathts-matrix",
  "version": "0.7.0",
  "description": "Matrix operations for MathTS with WASM/WebGPU backend support",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/copy-wasm.mjs",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsup src/index.ts --format esm --dts --clean --minify --treeshake && node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@danielsimonjr/mathts-core": "^0.13.0",
    "@danielsimonjr/mathts-gpu": "^0.2.0",
    "@danielsimonjr/mathts-parallel": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.5",
    "@webgpu/types": "^0.1.67"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/mathts",
    "directory": "matrix"
  },
  "keywords": [
    "math",
    "matrix",
    "linear-algebra",
    "typescript",
    "wasm",
    "webgpu"
  ],
  "peerDependencies": {
    "@webgpu/types": "^0.1.67"
  },
  "peerDependenciesMeta": {
    "@webgpu/types": {
      "optional": true
    }
  }
}
