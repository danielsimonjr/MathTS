{
  "name": "@danielsimonjr/mathts-matrix",
  "version": "0.7.5",
  "description": "Matrix operations for MathTS with WASM/WebGPU backend support",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.dts.json && node scripts/copy-wasm.mjs",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess \"tsc -p tsconfig.dts.json && node scripts/copy-wasm.mjs\"",
    "test": "bun test --isolate --timeout 30000",
    "test:watch": "vitest",
    "test:coverage": "bun test --isolate --timeout 30000 --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "clean": "rm -rf dist",
    "build:prod": "tsup src/index.ts --format esm --clean --minify --treeshake && tsc -p tsconfig.dts.json && node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@danielsimonjr/mathts-core": "^0.15.5",
    "@danielsimonjr/mathts-gpu": "^0.2.1",
    "@danielsimonjr/mathts-parallel": "^0.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "@webgpu/types": "^0.1.72"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/MathTS.git",
    "directory": "matrix"
  },
  "keywords": [
    "math",
    "matrix",
    "linear-algebra",
    "typescript",
    "wasm",
    "webgpu"
  ],
  "peerDependencies": {
    "@webgpu/types": "^0.1.72"
  },
  "peerDependenciesMeta": {
    "@webgpu/types": {
      "optional": true
    }
  }
}
